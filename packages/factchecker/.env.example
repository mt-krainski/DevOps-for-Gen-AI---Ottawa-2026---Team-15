# Copy this file to .env and fill in the two required values. The copy holds live
# credentials, and .gitignore excludes it.

# Required. The OpenRouter API key the chat model authenticates with.
OPENROUTER_API_KEY=

# Required. The Bright Data API token. It travels inside the MCP endpoint URL, so
# the tool prints and logs that URL with the token replaced by REDACTED.
BRIGHTDATA_API_TOKEN=

# Everything below is optional. Each line shows the default that applies while the
# variable is unset, and uncommenting a line overrides it.

# The OpenRouter model slug. Pin an explicit version rather than a `-latest` alias:
# the evaluation suite cannot tell a prompt regression from a model swap underneath
# it. Prices are dollars per million input and output tokens.
#   google/gemma-4-31b-it        $0.08 / $0.35   the default
#   anthropic/claude-sonnet-5    $2 / $10        a stronger reading of ambiguous
#                                                evidence, at twenty-five times the
#                                                input price
#   google/gemma-4-31b-it:free   free            the same model for prompt iteration.
#                                                It enforces no JSON schema, and it
#                                                is capped at 20 requests a minute
#                                                and, below $10 of purchased credit,
#                                                50 a day. Set FACTCHECKER_CONCURRENCY
#                                                to 2 while it is selected.
# Every other model named here is paid, and a paid model carries no platform
# request cap.
#FACTCHECKER_MODEL=google/gemma-4-31b-it

# How many tool calls one statement's check may make before it must rule on what it
# has.
#FACTCHECKER_TOOL_CALL_BUDGET=10

# The most characters of one fetched page that reach the model.
#FACTCHECKER_PAGE_CHARACTER_CEILING=100000

# How many statements are checked at once.
#FACTCHECKER_CONCURRENCY=8

# How long one statement's check may run before it is cancelled, in seconds.
#FACTCHECKER_STATEMENT_TIMEOUT_SECONDS=240.0

# How many times one Bright Data call is made in all, where it failed for a reason
# another try might fix. At 3 that is the first try and two retries. A failure no
# retry would fix ends the call at once. Model requests are not retried here.
#FACTCHECKER_RETRY_ATTEMPTS=3

# The log level, where --verbose is not given. INFO where this is unset or names no
# level the standard library knows. This name carries no prefix because the tool
# already published it.
#LOG_LEVEL=INFO
